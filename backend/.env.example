# ── Application ──
APP_NAME=AgriNova AI
APP_ENV=development
DEBUG=true

# ── Security ──
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ──
# For local dev with SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///./agrinova.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/agrinova

# ── Redis (optional, for caching) ──
REDIS_URL=redis://localhost:6379/0

# ── External APIs ──
WEATHER_API_BASE_URL=https://api.open-meteo.com
GEOCODING_API_URL=https://geocoding-api.open-meteo.com

# ── File Storage ──
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ── ML Models ──
ML_MODEL_DIR=./ml/models
