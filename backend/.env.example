# ── Application ──
APP_NAME=AgriNova AI
APP_ENV=development
DEBUG=true

# ── Security ──
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ──
# For local dev with SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///./agrinova.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/agrinova

# ── Redis (optional, for caching) ──
REDIS_URL=redis://localhost:6379/0

# ── External APIs ──
WEATHER_API_BASE_URL=https://api.open-meteo.com
GEOCODING_API_URL=https://geocoding-api.open-meteo.com

# ── File Storage ──
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ── ML Models ──
ML_MODEL_DIR=./ml/models

# ── AI Agronomist (V3) ──
GEMINI_API_KEY=your-gemini-api-key-here
AI_MODEL_NAME=gemini-2.0-flash

# ── AI Provider Failover (Phase 9.5) ──
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=
AI_PRIMARY_PROVIDER=gemini
AI_ENABLE_FALLBACK=true

# ── Rate Limiting ──
AI_RATE_LIMIT_MAX_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=60
