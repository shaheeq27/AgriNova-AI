# ═══════════════════════════════════════════════════════════════
# AgriNova AI — .gitignore
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/

# Python build / distribution
dist/
build/
.eggs/
*.egg
pip-wheel-metadata/

# Test / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# ─────────────────────────────────────────────────────────────
# Virtual Environments
# ─────────────────────────────────────────────────────────────
.venv/
venv/
ENV/
env/

# ─────────────────────────────────────────────────────────────
# Environment Variables / Secrets
# ─────────────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ─────────────────────────────────────────────────────────────
# Databases / Local Runtime Data
# ─────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.sqlite-journal

# Local database / runtime files
backend/*.db
backend/*.pid
*.pid

# ─────────────────────────────────────────────────────────────
# IDE / Editor
# ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─────────────────────────────────────────────────────────────
# macOS
# ─────────────────────────────────────────────────────────────
.AppleDouble
.LSOverride
._*

# ─────────────────────────────────────────────────────────────
# Node / Next.js / Frontend
# ─────────────────────────────────────────────────────────────
node_modules/
.next/
out/
.turbo/
.vercel/
coverage/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─────────────────────────────────────────────────────────────
# ML Model Artifacts
# ─────────────────────────────────────────────────────────────
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.bin

# Model directories / generated model binaries
models/*.bin
backend/ml_assets/models/

# ─────────────────────────────────────────────────────────────
# Large External Datasets
# ─────────────────────────────────────────────────────────────

# Never commit downloaded external datasets
backend/data/external/

# Common dataset/archive formats
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# ─────────────────────────────────────────────────────────────
# ML Generated Outputs / Caches
# ─────────────────────────────────────────────────────────────
wandb/
mlruns/
runs/
checkpoints/
tensorboard/
*.tfevents.*

# Generated ML experiment artifacts

*.npy
backend/ml/experiments/**/best_model.pth
backend/ml/experiments/**/robust_best_model.pth
backend/ml/experiments/**/mtl_best_model.pth
backend/ml/experiments/**/confusion_matrix.npy
backend/ml/experiments/**/external_confusion_matrix.npy
backend/ml/experiments/**/robust_confusion_matrix.npy
backend/ml/experiments/**/mtl_confusion_matrix.npy



# ─────────────────────────────────────────────────────────────
# Logs
# ─────────────────────────────────────────────────────────────
*.log
logs/

# ─────────────────────────────────────────────────────────────
