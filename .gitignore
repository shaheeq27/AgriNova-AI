# ═══════════════════════════════════════════════════
# AgriNova AI — .gitignore
# ═══════════════════════════════════════════════════

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/

# ── Virtual Environments ──
.venv/
venv/
ENV/

# ── Environment Variables ──
.env
.env.local
.env.*.local

# ── Database ──
*.db
*.sqlite3

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db

# ── Node / Frontend ──
node_modules/
.next/
out/
.turbo/

# ── ML Models ──
*.pkl
*.joblib
*.h5
*.pt
*.onnx
models/*.bin

# ── Logs ──
*.log
logs/

# ── Coverage / Testing ──
htmlcov/
.coverage
.pytest_cache/
.mypy_cache/

# ── Docker ──
docker-compose.override.yml

# ── Misc ──
*.bak
*.tmpagrinova.db
